# Client-safe environment values.
#
# This file IS bundled into the app (see pubspec.yaml assets) and is therefore
# readable by anyone who unpacks a build. Only put values here that are safe to
# be public:
#   - SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY: designed to be shipped in clients,
#     protected server-side by Row Level Security.
#   - QR_HMAC_SECRET: used client-side to sign/verify QR table tokens.
#
# NEVER put SUPABASE_SECRET_KEY or DATABASE_URL here — those stay in the root
# .env (gitignored, never bundled) and are for server/tooling use only.
SUPABASE_URL=https://sjaytekokwcvfjlbrsfm.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_BDgWRw7xUPBxH-4bT9V8mw_6lqDmTPd
QR_HMAC_SECRET=kalpa-cafe-shared-secret-change-me
