9# Client-safe environment values — COPY to assets/app.env and fill in.
#
# assets/app.env is bundled into the app and readable by anyone who unpacks a
# build, so it must contain ONLY values that are safe to be public. It is
# gitignored so the values are not committed to version control.
#
# NEVER put SUPABASE_SECRET_KEY or DATABASE_URL here — those stay in the root
# .env (also gitignored) and are for server/tooling use only.
#
# QR table-token signing/verification moved server-side (Supabase Vault +
# RPCs generate_table_qr / redeem_table_qr). No secret lives in the client.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX
